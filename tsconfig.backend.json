{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "next"
    ]
  },
  "include": [
    "web/lib/**/*.ts",
    "web/app/api/**/*.ts",
    "monitor/**/*.ts",
    "api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "web/.next",
    "api/.next"
  ]
}
