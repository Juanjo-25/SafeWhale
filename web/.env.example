# El navegador usa siempre /api/ del mismo dominio. API_URL es un binding
# privado de Vercel, inyectado en web; no se configura ni publica manualmente.
# Dirección opcional para el hook MetaMask. /app usa la API según BACKEND_MODE.
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Configuración privada del servidor. El ejemplo completo está en ../.env.example.
STORAGE_BACKEND=file
STATE_NAMESPACE=demo
# PostgreSQL -> Session pooler (5432), con ?sslmode=verify-full.
DATABASE_URL=
