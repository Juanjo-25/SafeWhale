# Copiar mediante: pnpm env:init
# Destino único: web/.env.local (lo leen Next.js y los scripts del monitor).
# Este ejemplo no contiene credenciales. Nunca usar NEXT_PUBLIC_ para secretos.

# simulado permite preparar la API sin contrato ni wallets.
# testnet exige dirección, bloque, llaves de agente/usuario y token de acceso.
BACKEND_MODE=simulado
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
RPC_TIMEOUT_MS=10000
CONTRACT_ADDRESS=
CONTRACT_DEPLOY_BLOCK=
# Wallet de despliegue y fondeo; no se usa para compras ni payouts.
OWNER_PRIVATE_KEY=
TX_WAIT_MS=45000
AGENT_PRIVATE_KEY=
DEMO_USER_PRIVATE_KEY=

# Modelo configurable: verificar disponibilidad y cuota en Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000

APP_BASE_URL=http://127.0.0.1:3001
MONITOR_INTERVAL_MS=2000
# http en pnpm dev; el daemon cloud lee el mock desde Supabase (store).
MONITOR_SOURCE=http
# API_URL lo inyecta Vercel por binding. No definirlo manualmente.
# Ruta relativa a web/, independientemente del cwd del proceso.
STATE_FILE=../state.json
# Supabase: activar después de ejecutar SQL e importar los archivos existentes.
STORAGE_BACKEND=file
STATE_NAMESPACE=demo
# Connect -> Session pooler (5432). Añadir ?sslmode=verify-full.
DATABASE_URL=
# Opcional en simulación local; requerido para acceso protegido fuera de loopback.
DEMO_API_TOKEN=
