# Copiar mediante: pnpm env:init
# Destino único: web/.env.local (lo leen Next.js y los scripts del monitor).
# Este ejemplo no contiene credenciales. Nunca usar NEXT_PUBLIC_ para secretos.

# simulado permite preparar la API sin contrato ni wallets.
# testnet exige dirección de contrato y las dos llaves privadas válidas.
BACKEND_MODE=simulado
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
RPC_TIMEOUT_MS=10000
CONTRACT_ADDRESS=
AGENT_PRIVATE_KEY=
DEMO_USER_PRIVATE_KEY=

# Modelo configurable: verificar disponibilidad y cuota en Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000

APP_BASE_URL=http://127.0.0.1:3001
MONITOR_INTERVAL_MS=2000
# Ruta relativa a web/, independientemente del cwd del proceso.
STATE_FILE=../state.json
# env:init genera un token local. Los endpoints de control aún no están implementados.
DEMO_API_TOKEN=
